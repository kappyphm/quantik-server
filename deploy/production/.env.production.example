BACKEND_IMAGE=kappyphm/quantik:backend-RELEASE
FRONTEND_IMAGE=kappyphm/quantik:frontend-RELEASE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_HEX
QUANTIK_ENVIRONMENT=production
QUANTIK_DATABASE_URL=postgresql+psycopg://quantik:REPLACE_WITH_RANDOM_HEX@postgres:5432/quantik
QUANTIK_AMQP_URL=amqp://quantik:REPLACE_WITH_RANDOM_HEX@rabbitmq:5672/%2F
QUANTIK_PUBLIC_ORIGIN=https://quantik.io.vn
QUANTIK_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
QUANTIK_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
QUANTIK_INTEGRATION_ENCRYPTION_KEY_PATH=/run/secrets/integration-encryption.key
QUANTIK_ADMIN_USERNAME=admin
QUANTIK_NUMERICAL_THREADS=1
QUANTIK_ALLOW_FIXTURE_ANALYSIS=false
QUANTIK_ALLOW_DEGRADED_ANALYSIS=false
QUANTIK_PAYMENTS_ENABLED=false
QUANTIK_SCHEDULED_PROVIDER_ENABLED=false
QUANTIK_RELEASE_ID=release-001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VNSTOCK_API_KEY=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_TRANSFER_PREFIX=
SEPAY_REQUIRES_TRANSFER_PREFIX=false
QUANTIK_METRICS_TOKEN=
