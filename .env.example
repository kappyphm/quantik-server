# Local SQLite is for development only; deployment uses PostgreSQL.
QUANTIK_DATABASE_URL=sqlite:///runtime/quantik.sqlite
QUANTIK_ENVIRONMENT=development
QUANTIK_PUBLIC_ORIGIN=http://localhost:8000
# Generate keys with: quantik generate-keys
QUANTIK_JWT_PRIVATE_KEY_PATH=runtime/jwt-private.pem
QUANTIK_JWT_PUBLIC_KEY_PATH=runtime/jwt-public.pem
QUANTIK_ADMIN_USERNAME=admin
QUANTIK_ADMIN_PASSWORD=
QUANTIK_NUMERICAL_THREADS=1
QUANTIK_AMQP_URL=amqp://guest:guest@127.0.0.1:5672/%2F
# Fixture/degraded execution is forbidden in production. Keep false for live customer traffic.
QUANTIK_ALLOW_FIXTURE_ANALYSIS=false
QUANTIK_ALLOW_DEGRADED_ANALYSIS=false
# Provider secrets are consumed only by their adapters, never logged.
VNSTOCK_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# If the bank connection requires a TKP/VA prefix, include it here.
SEPAY_TRANSFER_PREFIX=
SEPAY_REQUIRES_TRANSFER_PREFIX=false
# Enable after bank connection, reference/QR and webhook configuration are verified.
QUANTIK_PAYMENTS_ENABLED=false
